{
  "name": "dsh-agent-conductor",
  "version": "0.1.0",
  "description": "Delegate work from DeepSeek Harness to other agent CLIs (Codex, Claude Code) as subagents — the harness as conductor.",
  "type": "module",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-subagent-codex": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-subagent-claude-code": "^0.0.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  }
}