{
  "name": "dsh-agent-conductor",
  "version": "0.4.0",
  "description": "In-session cross-agent dispatch for DeepSeek Harness: a zero-dependency skill and bundle that send self-contained tasks to 11 external agent CLIs (Codex, Claude Code, TraeCode, OpenCode, Gemini, Cursor, Kimi, Qwen, Copilot, WorkBuddy, Grok), plus the 大肥鱼指挥官 (Big Fat Fish Commander) live fleet panel in the sidebar.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "scripts": {
    "test": "node --test tests/conductor-output.test.mjs tests/conductor-store.test.mjs tests/conductor-route.test.mjs tests/conductor-client.test.mjs"
  },
  "files": [
    "index.js",
    "conductor-store.js",
    "conductor-dynamic.js",
    "client.js",
    "assets",
    "cordis.patch.yml",
    "skills",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MJorgin/dsh-agent-conductor.git"
  },
  "homepage": "https://github.com/MJorgin/dsh-agent-conductor#readme",
  "bugs": {
    "url": "https://github.com/MJorgin/dsh-agent-conductor/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "agent", "codex", "claude-code", "multica", "conductor", "dispatch", "panel", "desktop", "commander"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
