  "description": "In-session cross-agent dispatch for DeepSeek Harness: a zero-dependency skill and a host-only bundle that send self-contained tasks to 11 external agent CLIs (Codex, Claude Code, TraeCode, OpenCode, Gemini, Cursor, Kimi, Qwen, Copilot, WorkBuddy, Grok).",
  "type": "module",
  "main": "index.js",
  "files": ["index.js", "conductor-dynamic.js", "cordis.patch.yml", "skills", "README.md", "docs"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MJorgin/dsh-agent-conductor.git"
  },
  "homepage": "https://github.com/MJorgin/dsh-agent-conductor#readme",
  "bugs": {
    "url": "https://github.com/MJorgin/dsh-agent-conductor/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "agent", "codex", "claude-code", "multica", "conductor", "dispatch"],
